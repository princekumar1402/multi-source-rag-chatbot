# ==============================================================================
# Multi-Source RAG Platform Environment Configuration (.env.example)
# Copy to .env and configure for your deployment environment
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
DEBUG=False
PROJECT_NAME="Multi-Source RAG Platform"

# Groq LLM Configuration (Get key at https://console.groq.com)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.0

# Embedding Model Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Store (FAISS) & BM25
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=data/vector_store

# Document Ingestion & Chunking
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
MAX_CONTENT_LENGTH=52428800

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@localhost:5434/rag_db
POSTGRES_PORT=5434
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db

# Database Connection Pooling (Phase 10)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# In-Process Multi-Tier Caching (Phase 10)
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000
EMBEDDING_CACHE_ENABLED=True
RETRIEVAL_CACHE_ENABLED=True
ANSWER_CACHE_ENABLED=True
QUERY_REWRITE_CACHE_ENABLED=True
RERANKER_CACHE_ENABLED=True

# Advanced RAG & Reranker (Phase 11)
RERANKER_ENABLED=True
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
QUERY_REWRITE_ENABLED=True

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Observability & Logging
LOG_LEVEL=INFO
PERFORMANCE_BENCHMARK_ENABLED=False
