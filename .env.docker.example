# ==============================================================================
# Docker Compose Environment Configuration Reference (.env.docker.example)
# Use this when running via `docker compose up`
# ==============================================================================

APP_ENV=production
DEBUG=False
PROJECT_NAME="Multi-Source RAG Platform"

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq
LLM_TEMPERATURE=0.0

# Embedding Configuration
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Vector Store Path inside Docker container
VECTOR_STORE_TYPE=faiss
VECTOR_STORE_PATH=/app/data/vector_store

# PostgreSQL Credentials for Container Networking
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_db
POSTGRES_PORT=5434

# Internal container database connection string (host is service name "postgres")
DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache Settings
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# CORS
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:5173","http://127.0.0.1"]

LOG_LEVEL=INFO
